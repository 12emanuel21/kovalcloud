generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// RBAC: SUPERADMIN (global, sin restaurante) · OWNER (dueño de un restaurante) · KITCHEN (personal de cocina)
enum Role {
  SUPERADMIN
  OWNER
  KITCHEN
}

enum OrderType {
  DINE_IN
  DELIVERY
  TAKEAWAY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERED
  CANCELLED
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  password           String
  name               String
  twoFactorSecret    String?
  isTwoFactorEnabled Boolean  @default(false)
  role               Role     @default(OWNER)
  isActive           Boolean  @default(true)
  // Último cambio de contraseña: los JWT emitidos antes dejan de ser válidos
  passwordChangedAt  DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Un usuario pertenece a un restaurante (null para SUPERADMIN)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Cuenta de cocina de una sede: su KDS solo recibe los pedidos de esa sede (null = todas)
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
}

model Plan {
  id          String       @id @default(uuid())
  name        String
  price       Float
  restaurants Restaurant[]
}

model Restaurant {
  id            String  @id @default(uuid())
  name          String
  slug          String  @unique
  subdomain     String  @unique // Ej: "pizzeria-napoles" -> pizzeria-napoles.kovalcloud.com
  description   String?
  phone         String?
  logoUrl       String?
  bannerUrl     String?
  currency      String  @default("COP")
  botpressBotId String? @default("koval-pizzeria-bot")

  // Configuración operativa del local
  address             String?
  paymentDetails      String?
  // Tarifa plana de domicilio en COP (ej. 15000): se cobra cuando el barrio no está en ninguna zona
  defaultDeliveryFee  Float?
  // Reglas del negocio escritas por el dueño (Ajustes > Perfil); el asistente de WhatsApp las aplica
  customInstructions  String?   @db.VarChar(800)
  // Domicilio por distancia (pin GPS): coordenadas del local y tarifa escalonada por km.
  // Sin coordenadas el motor no se usa y aplican las zonas / la tarifa estándar.
  latitude            Float?
  longitude           Float?
  baseDeliveryFee     Float     @default(4000)
  baseDeliveryKm      Float     @default(2.0)
  extraKmFee          Float     @default(1500)
  maxDeliveryRadiusKm Float     @default(8.0)
  businessHours       Json?
  isTemporarilyClosed Boolean   @default(false)
  closedMessage       String?
  extendedUntil       DateTime?
  // Tema visual de la carta pública: street-burger | cafe-bakery | sushi-dark | bistro-grill (src/restaurants/menu-themes.ts)
  theme               String    @default("street-burger")
  // Modo con el que abre la carta (light | dark); luego el cliente lo cambia con el botón ☀️/🌙
  menuColorMode       String    @default("dark")
  // Estructura de la carta: visual-grid | compact-row | bistro-classic | modern-tabs
  layout              String    @default("visual-grid")
  // Marca propia: color de acento libre (HEX "#e11d48"; null = el del tema) y tipografía de la carta
  customColor         String?
  fontFamily          String    @default("sans-modern")

  // Integración Meta WhatsApp Cloud API (Multi-Tenant)
  whatsappToken       String?
  whatsappPhoneId     String?
  whatsappWabaId      String?
  whatsappVerifyToken String? @default(uuid())
  // Número real (solo dígitos, con indicativo) de la línea conectada al bot: la SIM vinculada a
  // Baileys (al conectar) o el display_phone_number de Meta. null = sin sesión vinculada.
  whatsappBotNumber   String?
  // BYOA (Bring Your Own App): App Secret de la app de Meta del restaurante.
  // Verifica la firma x-hub-signature-256 de SUS webhooks. Nunca se devuelve en la API.
  metaAppSecret       String?

  // Pasarela de pagos Wompi (Bancolombia). Solo la llave pública sale al cliente;
  // el resto se oculta con sanitizeRestaurant.
  wompiPublicKey       String? // pub_test_... / pub_prod_...
  wompiPrivateKey      String? // prv_... (consultas a la API de Wompi)
  wompiEventSecret     String? // Verifica la firma (checksum) de los webhooks
  wompiIntegritySecret String? // Firma de integridad obligatoria del link de pago
  // Interruptor manual del dueño: aunque las llaves estén completas, sin esto no se cobra en línea
  isWompiEnabled       Boolean @default(false)

  // Usuarios del restaurante (dueños, y a futuro staff)
  users User[]

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  // Relaciones de la Fase 2 (Menú Digital)
  categories MenuCategory[]
  items      MenuItem[]

  // Relaciones del Módulo de Pedidos
  orders         Order[]
  drivers        DeliveryDriver[]
  customers      Customer[]
  deliveryZones  DeliveryZone[]
  branches       Branch[]
  autoReplies    AutoReply[]
  supportTickets SupportTicket[]
  chatHistories  ChatHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- MODELOS DE LA FASE 2 (MENÚ DIGITAL) ---

model MenuCategory {
  id    String @id @default(uuid())
  name  String // Ej: "Pizzas Tradicionales", "Bebidas"
  order Int    @default(0) // Para ordenar en la vista web

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  items MenuItem[]

  // Borrado lógico: se conserva para no romper el historial de pedidos
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id          String  @id @default(uuid())
  name        String // Ej: "Pizza Pepperoni"
  description String? // Ej: "Queso mozzarella, salsa de tomate y pepperoni americano"
  price       Float // Ej: 35000.0
  imageUrl    String? // URL de la imagen del plato
  isAvailable Boolean @default(true) // Switch para marcar platos agotados

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Relaciones del Módulo de Pedidos
  orderItems OrderItem[]

  // Borrado lógico: OrderItem -> MenuItem es RESTRICT, el historial debe seguir intacto
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- MODELOS DEL MÓDULO DE PEDIDOS (ORDERS) ---

model Order {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  customerName    String
  customerPhone   String
  deliveryAddress String?
  // total = subtotal (productos) + deliveryFee (domicilio según la zona)
  subtotal        Float       @default(0)
  deliveryFee     Float       @default(0)
  total           Float
  // Barrio del domicilio y zona de cobertura con la que se cobró el envío
  neighborhood    String?
  // Pin GPS del cliente (carta web o ubicación de WhatsApp) y distancia vial estimada al local
  customerLat        Float?
  customerLng        Float?
  deliveryDistanceKm Float?
  deliveryZoneId  String?
  deliveryZone    DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Sede que prepara el pedido (por la zona del domicilio o la elegida para recoger); null = sin sedes
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orderType       OrderType   @default(DELIVERY)
  tableNumber     String?
  channel         String?     @default("WEB_MENU")
  status          OrderStatus @default(PENDING)
  notes           String?

  // Pago en línea (Wompi). paymentStatus: PENDING, PAID, FAILED, CANCELLED
  paymentStatus    String  @default("PENDING")
  paymentReference String? @unique // Referencia enviada a la pasarela (KOV-...)
  paymentMethod    String? // Ej: NEQUI, CARD, PSE, CASH
  // Comprobante enviado por WhatsApp (archivo de uploads/chat/<restaurantId>/) y cuándo llegó
  paymentProofUrl  String?
  paymentProofAt   DateTime?
  // Entregado / archivado desde el Kanban: sale del tablero activo, sigue en la BD y en el Excel
  archivedAt       DateTime?

  items OrderItem[]

  // Despacho a domicilio (POST /orders/:id/dispatch). Se guarda copia de los datos del repartidor:
  // el historial no cambia si luego se edita o se borra (o si se despachó con datos sueltos).
  driverId      String?
  driver        DeliveryDriver? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverName    String?
  driverPhone   String?
  driverVehicle String?
  dispatchedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Domiciliarios del restaurante (Ajustes > Repartidores). El KDS los elige al despachar.
model DeliveryDriver {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name        String
  phone       String // Dígitos con indicativo (573001234567), listo para wa.me
  vehicleInfo String? // Ej: "Moto AKT · ABC12D"
  isActive    Boolean @default(true)
  // Sede donde trabaja (null = cualquier sede)
  branchId    String?
  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  quantity  Int
  unitPrice Float
  subtotal  Float
}

model AutoReply {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  triggerWords String[] // Ej: ["hola", "buenas", "menu", "menú"]
  responseType String     @default("TEXT") // "TEXT", "DYNAMIC_MENU", "WEB_LINK"
  responseBody String? // Mensaje de texto (si aplica)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
}

model ChatHistory {
  id            String     @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerPhone String
  role          String // "user", "model" o "system" (marcadores como el reset)
  message       String
  // Adjunto: image | audio | document. mediaUrl es un archivo de uploads/chat/<restaurantId>/,
  // "menu.pdf" (la carta en PDF del local) o un enlace externo http(s)
  mediaType     String?
  mediaUrl      String?
  mediaName     String?
  mediaMime     String?
  createdAt     DateTime   @default(now())

  @@index([restaurantId, customerPhone])
}

model SupportTicket {
  id           String   @id @default(uuid())
  restaurantId String
  subject      String
  description  String
  status       String   @default("OPEN") // Estados: OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority     String   @default("NORMAL") // Prioridades: LOW, NORMAL, HIGH, URGENT
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
}

/// Cliente de un restaurante (web o WhatsApp), identificado por su teléfono en ese local.
/// termsAcceptedAt: autorización de tratamiento de datos (Ley 1581 de 2012).
model Customer {
  id              String     @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  phone           String
  name            String?
  address         String?
  neighborhood    String?
  termsAcceptedAt DateTime?
  lastActivityAt  DateTime   @default(now())
  orders          Order[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([restaurantId, phone])
  @@index([restaurantId, phone])
}

/// Zona de cobertura de domicilios con su tarifa. keywords: barrios o sectores que la identifican.
model DeliveryZone {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  keywords     String[]
  fee          Float
  isActive     Boolean    @default(true)
  // Sede que atiende los domicilios de esta zona (null = la sede principal)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orders       Order[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
}

// Sede de la marca (Ajustes > Sedes). La marca sigue siendo un solo Restaurant (carta, WhatsApp,
// clientes, pagos); la sede solo decide qué cocina prepara el pedido. isMain recibe los pedidos
// sin zona (tarifa estándar) y los de recoger sin sede elegida.
model Branch {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  address      String
  phone        String?
  isMain       Boolean    @default(false)
  isActive     Boolean    @default(true)
  // Domicilio por distancia: el pedido sale de la sede más cercana con coordenadas.
  // Tarifa propia opcional: null = la tarifa por distancia de la marca (Restaurant)
  latitude            Float?
  longitude           Float?
  baseDeliveryFee     Float?
  baseDeliveryKm      Float?
  extraKmFee          Float?
  maxDeliveryRadiusKm Float?

  orders        Order[]
  deliveryZones DeliveryZone[]
  drivers       DeliveryDriver[]
  users         User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}
