generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// RBAC: SUPERADMIN (global, sin restaurante) · OWNER (dueño de un restaurante) · KITCHEN (personal de cocina)
enum Role {
  SUPERADMIN
  OWNER
  KITCHEN
}

enum OrderType {
  DINE_IN
  DELIVERY
  TAKEAWAY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERED
  CANCELLED
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  password           String
  name               String
  twoFactorSecret    String?
  isTwoFactorEnabled Boolean  @default(false)
  role               Role     @default(OWNER)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Un usuario pertenece a un restaurante (null para SUPERADMIN)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model Plan {
  id          String       @id @default(uuid())
  name        String
  price       Float
  restaurants Restaurant[]
}

model Restaurant {
  id            String  @id @default(uuid())
  name          String
  slug          String  @unique
  subdomain     String  @unique // Ej: "pizzeria-napoles" -> pizzeria-napoles.kovalcloud.com
  description   String?
  phone         String?
  logoUrl       String?
  bannerUrl     String?
  currency      String  @default("COP")
  botpressBotId String? @default("koval-pizzeria-bot")

  // Configuración operativa del local
  address             String?
  paymentDetails      String?
  businessHours       Json?
  isTemporarilyClosed Boolean   @default(false)
  closedMessage       String?
  extendedUntil       DateTime?
  // Tema visual de la carta pública: street-burger | cafe-bakery | sushi-dark | bistro-grill (src/restaurants/menu-themes.ts)
  theme               String    @default("street-burger")
  // Modo con el que abre la carta (light | dark); luego el cliente lo cambia con el botón ☀️/🌙
  menuColorMode       String    @default("dark")
  // Estructura de la carta: visual-grid (tarjetas grandes) | compact-row (lista estilo delivery)
  layout              String    @default("visual-grid")

  // Integración Meta WhatsApp Cloud API (Multi-Tenant)
  whatsappToken       String?
  whatsappPhoneId     String?
  whatsappWabaId      String?
  whatsappVerifyToken String? @default(uuid())
  // Número real (solo dígitos, con indicativo) de la línea conectada al bot: la SIM vinculada a
  // Baileys (al conectar) o el display_phone_number de Meta. null = sin sesión vinculada.
  whatsappBotNumber   String?
  // BYOA (Bring Your Own App): App Secret de la app de Meta del restaurante.
  // Verifica la firma x-hub-signature-256 de SUS webhooks. Nunca se devuelve en la API.
  metaAppSecret       String?

  // Pasarela de pagos Wompi (Bancolombia). Solo la llave pública sale al cliente;
  // el resto se oculta con sanitizeRestaurant.
  wompiPublicKey       String? // pub_test_... / pub_prod_...
  wompiPrivateKey      String? // prv_... (consultas a la API de Wompi)
  wompiEventSecret     String? // Verifica la firma (checksum) de los webhooks
  wompiIntegritySecret String? // Firma de integridad obligatoria del link de pago
  // Interruptor manual del dueño: aunque las llaves estén completas, sin esto no se cobra en línea
  isWompiEnabled       Boolean @default(false)

  // Usuarios del restaurante (dueños, y a futuro staff)
  users User[]

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  // Relaciones de la Fase 2 (Menú Digital)
  categories MenuCategory[]
  items      MenuItem[]

  // Relaciones del Módulo de Pedidos
  orders         Order[]
  autoReplies    AutoReply[]
  supportTickets SupportTicket[]
  chatHistories  ChatHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- MODELOS DE LA FASE 2 (MENÚ DIGITAL) ---

model MenuCategory {
  id    String @id @default(uuid())
  name  String // Ej: "Pizzas Tradicionales", "Bebidas"
  order Int    @default(0) // Para ordenar en la vista web

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  items MenuItem[]

  // Borrado lógico: se conserva para no romper el historial de pedidos
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id          String  @id @default(uuid())
  name        String // Ej: "Pizza Pepperoni"
  description String? // Ej: "Queso mozzarella, salsa de tomate y pepperoni americano"
  price       Float // Ej: 35000.0
  imageUrl    String? // URL de la imagen del plato
  isAvailable Boolean @default(true) // Switch para marcar platos agotados

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Relaciones del Módulo de Pedidos
  orderItems OrderItem[]

  // Borrado lógico: OrderItem -> MenuItem es RESTRICT, el historial debe seguir intacto
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- MODELOS DEL MÓDULO DE PEDIDOS (ORDERS) ---

model Order {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  customerName    String
  customerPhone   String
  deliveryAddress String?
  total           Float
  orderType       OrderType   @default(DELIVERY)
  tableNumber     String?
  channel         String?     @default("WEB_MENU")
  status          OrderStatus @default(PENDING)
  notes           String?

  // Pago en línea (Wompi). paymentStatus: PENDING, PAID, FAILED, CANCELLED
  paymentStatus    String  @default("PENDING")
  paymentReference String? @unique // Referencia enviada a la pasarela (KOV-...)
  paymentMethod    String? // Ej: NEQUI, CARD, PSE, CASH

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  quantity  Int
  unitPrice Float
  subtotal  Float
}

model AutoReply {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  triggerWords String[] // Ej: ["hola", "buenas", "menu", "menú"]
  responseType String     @default("TEXT") // "TEXT", "DYNAMIC_MENU", "WEB_LINK"
  responseBody String? // Mensaje de texto (si aplica)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
}

model ChatHistory {
  id            String     @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerPhone String
  role          String // "user", "model" o "system" (marcadores como el reset)
  message       String
  createdAt     DateTime   @default(now())

  @@index([restaurantId, customerPhone])
}

model SupportTicket {
  id           String   @id @default(uuid())
  restaurantId String
  subject      String
  description  String
  status       String   @default("OPEN") // Estados: OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority     String   @default("NORMAL") // Prioridades: LOW, NORMAL, HIGH, URGENT
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
}
