# Copiar a .env y rellenar. Generar valores con: openssl rand -hex 32
GOOGLE_GENERATIVE_AI_API_KEY=

# Contraseña del usuario koval_admin de Postgres (solo hex/alfanumérico: va dentro de DATABASE_URL).
# OJO: cambiarla aquí NO cambia la de un volumen existente; usar también ALTER USER.
POSTGRES_PASSWORD=

# Firma de los JWT. Cambiarlo invalida todas las sesiones activas.
JWT_SECRET=

# Clave compartida backend <-> microservicio WhatsApp (cabecera x-api-key)
INTERNAL_API_KEY=

# NOTA: el Meta App Secret ya NO va aquí. Es por restaurante (modelo BYOA) y se configura
# en Dashboard > WhatsApp API > Meta App Secret. Sin él, los webhooks de ese restaurante se rechazan.

# URL pública del frontend (enlace al menú web cuando no hay PDF), ej: https://tudominio.com
# Obligatoria en docker-compose.prod.yml.
FRONTEND_URL=

# Solo docker-compose.prod.yml: token del túnel con nombre de Cloudflare
# (Zero Trust > Networks > Tunnels > tu túnel > instalar conector > el valor tras --token).
# En el panel, el "Service URL" del hostname público debe ser http://nginx:80
CLOUDFLARE_TUNNEL_TOKEN=
